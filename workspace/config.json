{
  "in": "in.jar",
  "out": "out.jar",
  "libs": "libs/",
  "dictionary": "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ",
  "computeFrames": true,
  "watermark": "i like kuzhi mandi",
  "aggressiveOverload": true,
  "exclusionPresets": [
    "api",
    "mc-fabric"
  ],
  "transformers": {
    "trim": {
      "enabled": true,
      "classes": true,
      "fields": true,
      "methods": true
    },
    "renameFields": {
      "enabled": true,
      "preserveRecordNames": true,
      "keepSerializableNames": false,
      "prefix": "",
      "shuffle": true
    },
    "renameMethods": {
      "enabled": true,
      "prefix": "",
      "shuffle": true
    },
    "renameClasses": {
      "enabled": true,
      "prefix": "a.",
      "mixinPrefix": "b.",
      "renameSourceFile": true,
      "randomize": true
    },
    "localNames": {
      "enabled": true
    },
    "lineNumbers": {
      "enabled": true,
      "remove": true
    },
    "methodSalting": {
      "enabled": true
    },
    "classSalting": {
      "enabled": true,
      "unifyAccess": true
    },
    "fixConstants": {
      "enabled": true
    },
    "integerEncrypt": {
      "enabled": true,
      "excludeLowSignificant": true
    },
    "encryptStrings": {
      "enabled": true,
      "translateConcat": true,
      "minLength": 2
    },
    "flowInts": {
      "enabled": true,
      "obfuscateLongs": true,
      "separateBlocks": true,
      "confuseFlow": true
    },
    "opaquePredicates": {
      "enabled": true
    },
    "controlFlowFlatten": {
      "enabled": true,
      "useSalt": true
    },
    "controlFlowShuffle": {
      "enabled": true
    },
    "cleanDeadCode": {
      "enabled": true
    },
    "referenceObfuscate": {
      "enabled": true
    },
    "hashIntegrity": {
      "enabled": true
    }
  }
}